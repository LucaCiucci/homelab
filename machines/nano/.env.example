# SSH public key for the deploy user (used by GitHub Actions to SCP files)
# Generate a dedicated key pair just for deployments:
#   ssh-keygen -t ed25519 -f ~/.ssh/deploy-key -N ""
# Then put the PUBLIC key here and the PRIVATE key in GitHub Secrets as SSH_PRIVATE_KEY
SSH_DEPLOY_PUBKEY=

UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
